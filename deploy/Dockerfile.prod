FROM node:24-alpine AS frontend
WORKDIR /frontend
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM python:3.12-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*
COPY cyoa-game-server/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY cyoa-game-server/ ./
COPY --from=frontend /frontend/dist/ ./static/frontend/
RUN chmod +x entrypoint.sh
ENV PYTHONUNBUFFERED=1 DJANGO_DEBUG=0 FRONTEND_DEV=0
EXPOSE 8000
ENTRYPOINT ["./entrypoint.sh"]
CMD ["gunicorn", "cyoa_server.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "2", "--threads", "2", "--timeout", "300", "--access-logfile", "-"]
