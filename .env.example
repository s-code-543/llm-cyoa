# Development needs no provider key here: configure OpenRouter in the local admin UI.
# Optional OpenAI TTS key (separate from the OpenRouter storytelling key):
OPENAI_API_KEY=
# Optional native whisper.cpp service:
WHISPER_API_URL=http://host.docker.internal:10300/v1/audio/transcriptions
# Production: set these in a separate, untracked env file passed with --env-file.
# DJANGO_SECRET_KEY=generate-a-long-random-secret
# DJANGO_ALLOWED_HOSTS=your.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your.example.com
# CLOUDFLARE_AUTH_ENABLED=true
# CLOUDFLARE_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# CLOUDFLARE_AUD=
# CLOUDFLARE_ADMIN_EMAILS=
